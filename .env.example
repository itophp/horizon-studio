# Local development only. Copy to .env or run horizon-cli env configure. No production credentials.
API_ADDR=127.0.0.1:8080
# Development frontend port used by horizon-cli.
WEB_PORT=5173
DATABASE_URL=postgres://baseline:local-development-only@127.0.0.1:54329/baseline?sslmode=disable
TEST_DATABASE_URL=postgres://baseline:local-development-only@127.0.0.1:54329/baseline?sslmode=disable
# Optional OIDC array: id, name, issuer, clientId, clientSecret, redirectUrl.
# redirectUrl must equal PUBLIC_APP_URL + /login/oidc. Requires SETTINGS_ENCRYPTION_KEY.
# HTTPS is required except explicit numeric loopback HTTP in local development.
IAM_OIDC_PROVIDERS_JSON=[]
# Optional SAML array: id, name, entityId, metadataXml, certificatePem, privateKeyPem.
# Uses deployment-trusted IdP metadata and an RSA >=2048 SP key/certificate.
# Requires SETTINGS_ENCRYPTION_KEY and an HTTPS PUBLIC_APP_URL, including local SAML testing.
# Configure IdP HTTP-POST ACS at PUBLIC_APP_URL + /api/auth/federation/saml/<id>/acs.
# IDs must be unique across OIDC/SAML; never commit provider keys or real metadata here.
IAM_SAML_PROVIDERS_JSON=[]
# Optional knowledge vector store override. With no override, use knowledge.vector.url.
# REDIS_URL=redis://127.0.0.1:63790
# Only false for loopback HTTP development; HTTPS deployments must use true.
COOKIE_SECURE=false
# Optional initial administrator overrides. Unset password uses the local default 111111.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_TENANT=workspace-default
# BOOTSTRAP_PASSWORD=111111
# Optional, local-only technical demo identity; separate from browser sessions.
DEMO_AUTH_TOKEN=
# Governance: base64-encoded 32-byte encryption key; generate outside Git and retain for backups.
# Required on non-loopback deployments, and for saving SMTP/driver secrets locally.
SETTINGS_ENCRYPTION_KEY=
# Optional base64 Ed25519 32-byte seed for signed security-audit checkpoints.
# Keep the seed and independently archived public checkpoints with deployment backups.
IAM_AUDIT_SIGNING_SEED=
# Comma-separated base64 Ed25519 public keys for verification after rotation.
IAM_AUDIT_PREVIOUS_PUBLIC_KEYS=
# Online audit window in days. 0 disables archiving. Enabling requires a signing seed.
IAM_AUDIT_ONLINE_DAYS=0
# Total audit retention in days, including the online window. 0 keeps archived events indefinitely.
IAM_AUDIT_RETENTION_DAYS=0
# Comma-separated Human Principal UUIDs for platform operations.
IAM_PLATFORM_OPERATOR_IDS=
# Optional HTTPS SMS delivery endpoint and bearer credential.
IAM_SMS_URL=
IAM_SMS_TOKEN=
# Absolute allowed storage root. Local loopback default: foundation/.local/storage;
# An existing legacy storage directory remains accessible after the repository move.
FILE_STORAGE_ROOT=
# Deployment tenant for browser sign-in, public branding, and IAM verification email.
PUBLIC_TENANT_ID=workspace-default
PUBLIC_APP_URL=http://127.0.0.1:5180
# Comma-separated SMTP host allowlist; blank disables publishing enabled SMTP.
SMTP_ALLOWED_HOSTS=
# Comma-separated exact personal-mail endpoints; blank disables external mailbox connections.
MAIL_ALLOWED_ENDPOINTS=
MAIL_MAX_MESSAGE_BYTES=26214400
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_ATTACHMENTS=20
MAIL_SEND_MAX_RECIPIENTS=200
MAIL_SYNC_BATCH=20
MAIL_RETRY_MAX=5

# Optional local development WebMCP. Loopback binding is enforced.
WEBMCP_PORT=18793
WEBMCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CODEX_BIN=/absolute/path/to/codex
# WEBMCP_STATE_DIR=.local/webmcp

# Remote business MCP helper. HTTPS in deployments; loopback HTTP is allowed for local development.
# The helper binds 127.0.0.1:18796 and pins the service origin at startup.
MCP_BUSINESS_URL=http://127.0.0.1:5173/mcp
# Optional isolated client configuration home for tests; omit for normal installs.
# MCP_CLIENT_HOME=
# CODEX_BIN=
